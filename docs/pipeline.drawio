<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio">
  <diagram id="paper-translator-overview" name="文献翻译流程">
    <mxGraphModel grid="1" gridSize="10" page="0" pageWidth="1160" pageHeight="1510" background="#ffffff" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="一篇论文，从原文到中文交付" style="text;html=1;fontFamily=Microsoft YaHei;fontSize=32;fontStyle=1;fontColor=#182230;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="30" width="1020" height="60" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="PAPER TRANSLATOR　 /　 正文与插图一起翻译、核验、归档" style="text;html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#667085;align=left;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="1020" height="30" as="geometry"/></mxCell>
        <mxCell id="input" value="&lt;b&gt;输入论文 PDF / Word&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;记录原件最初位置，建立独立工作目录&lt;/font&gt;" style="rounded=1;arcSize=35;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#244024;fillColor=#d5e8d4;strokeColor=#82b366;spacing=12;" vertex="1" parent="1"><mxGeometry x="100" y="160" width="500" height="90" as="geometry"/></mxCell>
        <mxCell id="env" value="&lt;b&gt;01　环境自检&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;1.0 · 检查 Acrobat Pro 与 Skill 本地 RapidOCR&lt;/font&gt;" style="rounded=1;arcSize=15;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#182230;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=12;" vertex="1" parent="1"><mxGeometry x="100" y="300" width="500" height="90" as="geometry"/></mxCell>
        <mxCell id="envnote" value="&lt;b&gt;环境门槛&lt;/b&gt;&lt;br&gt;本地 OCR 缺失 → 先询问安装同意&lt;br&gt;仅 Acrobat 可用 → 可直转并保留整图&lt;br&gt;两条路都不可用 → 暂停，安装后再自检" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#667085;align=left;spacing=0;" vertex="1" parent="1"><mxGeometry x="720" y="295" width="380" height="100" as="geometry"/></mxCell>
        <mxCell id="convert" value="&lt;b&gt;02　优先直接转 Word&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;2.0 · Acrobat 成功后直接继续，不问满意度&lt;br&gt;已有 Word 原件：跳过转换，进入图文提取&lt;/font&gt;" style="rounded=1;arcSize=15;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#182230;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=12;" vertex="1" parent="1"><mxGeometry x="100" y="450" width="500" height="110" as="geometry"/></mxCell>
        <mxCell id="ocr" value="&lt;b&gt;RapidOCR 重建 Word&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;2.2 · 展示预览，请用户确认质量&lt;br&gt;未确认或不满意：暂停处理&lt;/font&gt;" style="rounded=1;arcSize=15;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#3d3510;fillColor=#fff2cc;strokeColor=#d6b656;spacing=12;" vertex="1" parent="1"><mxGeometry x="720" y="450" width="380" height="110" as="geometry"/></mxCell>
        <mxCell id="extract" value="&lt;b&gt;03　提取正文，核对整图&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;2.1–3.0 · 核对图号、图注与整图完整性&lt;br&gt;OCR 路径或转换缺失时，回退提取并补图&lt;/font&gt;" style="rounded=1;arcSize=15;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#182230;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=12;" vertex="1" parent="1"><mxGeometry x="100" y="630" width="500" height="110" as="geometry"/></mxCell>
        <mxCell id="panels" value="&lt;b&gt;可选：面板切分与交叉验证&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;4.0 · 仅在用户选择后执行&lt;br&gt;验证标签、边界与内容是否完整&lt;/font&gt;" style="rounded=1;arcSize=15;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#3d3510;fillColor=#fff2cc;strokeColor=#d6b656;spacing=12;" vertex="1" parent="1"><mxGeometry x="720" y="700" width="380" height="110" as="geometry"/></mxCell>
        <mxCell id="translate" value="&lt;b&gt;04　翻译与排版&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;5.0–6.0 · 翻译正文与图注 → 写 Markdown&lt;br&gt;插图归位 → 加目录 → 内嵌图片 → 导出 PDF&lt;/font&gt;" style="rounded=1;arcSize=15;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#182230;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=12;" vertex="1" parent="1"><mxGeometry x="100" y="870" width="500" height="110" as="geometry"/></mxCell>
        <mxCell id="check" value="&lt;b&gt;05　核验译文中的图位置&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;6.0.1 · 有图就检查，不受可选面板验证影响&lt;br&gt;图号与顺序一致 · 章节语义对应 · 图与图注配对&lt;/font&gt;" style="rounded=1;arcSize=15;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#182230;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=12;" vertex="1" parent="1"><mxGeometry x="100" y="1040" width="500" height="110" as="geometry"/></mxCell>
        <mxCell id="checknote" value="&lt;b&gt;核验上下文，不要求页码相同&lt;/b&gt;&lt;br&gt;支持视觉时，渲染双方页面逐图比对&lt;br&gt;未做视觉核验时，交付说明中明确标注&lt;br&gt;&lt;br&gt;&lt;b&gt;任何 exit 3：先查清并修正，再继续&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#667085;align=left;spacing=0;" vertex="1" parent="1"><mxGeometry x="720" y="1030" width="380" height="130" as="geometry"/></mxCell>
        <mxCell id="archive" value="&lt;b&gt;06　归档、自检、交付&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;6.1–7.0 · 原件最初所在目录 / 文献中文题目 /&lt;br&gt;&lt;b&gt;原件　＋　中文 Markdown　＋　中文 PDF&lt;/b&gt;&lt;br&gt;实际核对路径与三件套，全部通过后才算完成&lt;/font&gt;" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#244024;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;spacing=12;" vertex="1" parent="1"><mxGeometry x="100" y="1220" width="1000" height="140" as="geometry"/></mxCell>
        <mxCell id="legend" value="蓝色：主流程　　黄色：条件分支 / 用户选择　　绿色：输入与交付" style="text;html=1;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#667085;align=left;" vertex="1" parent="1"><mxGeometry x="100" y="1390" width="1000" height="30" as="geometry"/></mxCell>
        <mxCell id="foot" value="生成的 Word 与图片仅作工作资源，默认不交付独立图集；用户明确指定交付位置或原件保留方式时，以其要求为准。" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#667085;align=left;" vertex="1" parent="1"><mxGeometry x="100" y="1430" width="1000" height="40" as="geometry"/></mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="input" target="env"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="env" target="convert"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="直转成功 / 已有 Word" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#667085;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="convert" target="extract"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="直转不可用" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#8a6d22;labelBackgroundColor=#ffffff;strokeColor=#d6b656;strokeWidth=2;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="convert" target="ocr"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="用户确认后" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#8a6d22;labelBackgroundColor=#ffffff;strokeColor=#d6b656;strokeWidth=2;endArrow=block;exitX=0.5;exitY=1;entryX=1;entryY=0.25;" edge="1" parent="1" source="ocr" target="extract"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="910" y="600"/><mxPoint x="650" y="600"/><mxPoint x="650" y="657.5"/></Array></mxGeometry></mxCell>
        <mxCell id="e6" value="跳过面板验证：保留整图" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#667085;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="extract" target="translate"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="用户选择" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#8a6d22;labelBackgroundColor=#ffffff;strokeColor=#d6b656;strokeWidth=2;dashed=1;endArrow=block;exitX=1;exitY=0.75;entryX=0;entryY=0.5;" edge="1" parent="1" source="extract" target="panels"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="660" y="712.5"/><mxPoint x="660" y="755"/></Array></mxGeometry></mxCell>
        <mxCell id="e8" value="验证通过" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#8a6d22;labelBackgroundColor=#ffffff;strokeColor=#d6b656;strokeWidth=2;dashed=1;endArrow=block;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="panels" target="translate"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="910" y="925"/></Array></mxGeometry></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="translate" target="check"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="核验通过" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#667085;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;endArrow=block;exitX=0.5;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="check" target="archive"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
